[Unit]
Description=spill torrent daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/spill serve --config %h/.config/spill/spill.toml
StateDirectory=spill
StateDirectoryMode=0700
RuntimeDirectory=spill
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
# Size any MemoryMax override for the actual torrent workload, not just caches.
MemoryAccounting=true

[Install]
WantedBy=default.target
