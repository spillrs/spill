[Unit]
Description=spill torrent daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spill
SyslogLevelPrefix=true
ExecStart=/usr/local/bin/spill serve --config %h/.config/spill/spill.toml
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
# Size any MemoryMax override for the actual torrent workload, not just caches.
MemoryAccounting=true

[Install]
WantedBy=default.target
